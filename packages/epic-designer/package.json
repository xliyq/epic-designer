{
  "name": "@ies/designer",
  "version": "0.0.3",
  "description": "A low-code drag-and-drop form designer based on Vue 3",
  "private": false,
  "keywords": [
    "form",
    "designer",
    "low-code",
    "visual",
    "form-builder"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./index.ts",
  "module": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    },
    "./uno.config": "./uno.config.ts",
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css",
    "**/*.less"
  ],
  "scripts": {
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest"
  },
  "publishConfig": {
    "registry": "https://npm.ies.work/"
  },
  "peerDependencies": {
    "monaco-editor": ">=0.48.0",
    "vue": ">=3.1.0"
  },
  "dependencies": {
    "@vueuse/core": "^13.0.0",
    "jsep": "^1.4.0",
    "vue-draggable-plus": "^0.6.1"
  },
  "optionalDependencies": {
    "@ies/antd": ">=0.0.2",
    "@ies/element-plus": ">=0.0.2",
    "@ies/naive-ui": ">=0.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.6",
    "@unocss/preset-rem-to-px": "^0.65.3",
    "rollup-plugin-copy": "^3.5.0",
    "rollup-plugin-node-externals": "^8.0.0",
    "unocss": "^0.65.3",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.2.0"
  }
}
