{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "stub": {
      "cache": false
    },
    "epic-examples#dev": {
      "dependsOn": [
        "@ies/antd#stub",
        "@ies/element-plus#stub",
        "@ies/naive-ui#stub"
      ],
      "cache": false,
      "persistent": true
    },
    "epic-examples#build": {
      "cache": true
    }
  }
}
