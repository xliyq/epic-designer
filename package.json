{
  "name": "epic-designer-project",
  "version": "1.1.13",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm i && turbo run build -F epic-examples && turbo run build",
    "dev": "turbo run dev",
    "lib": "vitest run && turbo run build -F epic-designer",
    "pack": "pnpm run build && cd packages/epic-designer && npm pack && cd ../ui/elementPlus && npm pack && cd ../..",
    "test": "vitest",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "examples:build": "pnpm run build -F epic-examples",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "eslint packages/ --fix",
    "postinstall": "pnpm -r run stub --if-present"
  },
  "dependencies": {
    "@vueuse/core": "catalog:"
  },
  "devDependencies": {
    "@ies/antd": "workspace:*",
    "@ies/base-ui": "workspace:*",
    "@ies/core": "workspace:*",
    "@ies/custom": "workspace:*",
    "@ies/element-plus": "workspace:*",
    "@ies/eslint-config": "workspace:*",
    "@ies/hooks": "workspace:*",
    "@ies/manager": "workspace:*",
    "@ies/naive-ui": "workspace:*",
    "@ies/panel-ui": "workspace:*",
    "@ies/scripts": "workspace:*",
    "@ies/types": "workspace:*",
    "@ies/utils": "workspace:*",
    "@turbo/gen": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/test-utils": "catalog:",
    "@ies/designer": "workspace:*",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "less": "catalog:",
    "naive-ui": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "unocss": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vitepress": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  },
  "packageManager": "pnpm@9.10.0"
}
